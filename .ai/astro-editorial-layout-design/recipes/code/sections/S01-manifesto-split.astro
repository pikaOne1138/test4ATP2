---
/** S01 manifesto-split — 標籤 | 大引言 | 補述 三段式立場面板（衍生自 10 共好 .cg-belief）。面板 = 淡底色，不是卡片。 */
interface Props { label?: string; sub?: string; quote?: string[]; voice?: string; note?: string }
const {
  label = 'A SHARED POSITION', sub = '不是一種方法，而是一種一起工作的方式。',
  quote = ['每個人都帶著自己的經驗來。'], voice = '支持，也可以有很多種形狀。',
  note = '我們尊重專業差異，也不把所有需求放進同一個服務。當需要的支持不在我們的範圍內，轉介與合作同樣重要。',
} = Astro.props;
---
<section class="s01">
  <div class="inner">
    <div class="l"><p class="label">{label}</p><p class="sub">{sub}</p></div>
    <blockquote>{quote.map((q) => <span class="ph">{q}</span>)} <em class="ph">{voice}</em></blockquote>
    <p class="note">{note}</p>
  </div>
</section>
<style>
  .s01 { padding-inline: var(--ed-gutter, 4vw); }
  .inner { max-width: var(--ed-wide, 1320px); margin-inline: auto; background: var(--ed-panel, #e9ebf5); padding: clamp(1.5rem, 4vw, 3rem); display: grid; grid-template-columns: .65fr 1.25fr .8fr; gap: 3vw; align-items: start; color: var(--ed-ink, #203d68); }
  .label { font: .75rem var(--ed-mono, monospace); letter-spacing: .13em; color: var(--ed-accent, #2d55cf); margin: 0; }
  .sub { margin: 1.5rem 0 0; font-size: .9rem; line-height: 1.7; color: var(--ed-ink-2, #4d5d7b); }
  blockquote { margin: 0; font: 700 clamp(1.7rem, 3.8vw, 3.4rem)/1.3 var(--ed-sans, sans-serif); letter-spacing: -.02em; text-wrap: balance; }
  .ph { display: inline-block; }
  em { font: 400 italic 1em var(--ed-serif, Georgia, serif); color: var(--ed-accent, #2d55cf); }
  .note { margin: 0; font-size: .9rem; line-height: 1.85; color: var(--ed-ink-2, #586b8d); }
  @media (max-width: 900px) { .inner { grid-template-columns: .5fr 1.5fr; } .note { grid-column: 2; } }
  @media (max-width: 580px) { .inner { grid-template-columns: 1fr; gap: 1.1rem; } .note { grid-column: auto; } .sub { margin-top: .5rem; } }
</style>