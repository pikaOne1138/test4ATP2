---
/**
 * S06 index-shelf — 固定寬索引欄 260px + 彈性書架欄；精選項是 <details> 抽屜（衍生自 04 .cu-catalog）。
 * 手機：索引 ol 轉橫向 chip 流，而不是整塊塞在頁首。無 JS。
 */
interface Props { title?: string[]; index?: string[]; note?: string; featured?: { no: string; tag: string; t: string; d: string; drawer: string; cover: string }; items?: { tag: string; t: string; d: string }[] }
const {
  title = ['收藏', '目錄'], index = ['01 / 值得一讀', '02 / 思考工具', '03 / 最近發現'],
  note = '這不是排行榜。只是某個人替你讀過、用過之後，留下的選擇。',
  featured = { no: '01', tag: '值得一讀 / BOOK', t: '一本讓人重新學會提問的書', d: '不是替你整理答案，而是把那些原本以為不必問的事，重新放回桌上。', drawer: '策展札記：選入收藏不代表它適合每一個人；這裡記下的是我為什麼留下它。', cover: '問題的形狀' },
  items = [{ tag: '02 / TOOL', t: '一個把想法連起來的工具', d: '適合手上有很多線索，卻還不急著把它們變成結論的人。' }, { tag: '03 / FIND', t: '一篇談記憶與地方的文章', d: '從小小的日常物件，開始理解一個地方如何被記住。' }],
} = Astro.props;
---
<section class="s06">
  <aside>
    <h2>{title[0]}<br />{title[1]}</h2>
    <ol>{index.map((i) => <li><a href="#shelf">{i}</a></li>)}</ol>
    <p class="note">{note}</p>
  </aside>
  <div class="shelf" id="shelf">
    <details class="feat" open>
      <summary>
        <span class="no">{featured.no}</span>
        <div><p class="tag">{featured.tag}</p><h3>{featured.t}</h3><p class="d">{featured.d}</p></div>
        <div class="cover" aria-hidden="true"><b>{featured.cover}</b></div>
      </summary>
      <div class="drawer"><p>{featured.drawer}</p></div>
    </details>
    <div class="row">{items.map((it) => <article><span class="tag">{it.tag}</span><h3>{it.t}</h3><p class="d">{it.d}</p></article>)}</div>
  </div>
</section>
<style>
  .s06 { max-width: var(--ed-wide, 1300px); margin-inline: auto; padding: 1.5rem var(--ed-gutter, 4vw) 0; border-top: 1px solid var(--ed-line, #b8b0ab); display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: 5vw; color: var(--ed-ink, #30252f); }
  h2 { font: 400 3rem/1.05 var(--ed-serif, Georgia, serif); letter-spacing: -.03em; margin: .6rem 0 1.7rem; }
  ol { list-style: none; padding: 0; margin: 0; } li { border-top: 1px solid var(--ed-line, #cfc7c2); } li a { display: flex; align-items: center; min-height: 44px; padding: .4rem 0; font: .8rem var(--ed-mono, monospace); color: inherit; text-decoration: none; }
  .note { font-size: .875rem; line-height: 1.7; color: var(--ed-ink-2, #575057); max-width: 15em; margin-top: 2rem; }
  .feat { border-bottom: 1px solid var(--ed-line, #b8b0ab); padding: 1.5rem 0; }
  summary { position: relative; display: grid; grid-template-columns: 2.6rem 1fr 150px; gap: 1.2rem; align-items: center; padding-right: 2rem; cursor: pointer; list-style: none; min-height: 44px; }
  summary::-webkit-details-marker { display: none; } summary::marker { content: ""; }
  summary::after { content: "＋"; position: absolute; right: .15rem; top: 45%; font: 1rem var(--ed-mono, monospace); color: var(--ed-accent, #5b4055); }
  .feat[open] summary::after { content: "−"; }
  .no { font: .8rem var(--ed-mono, monospace); color: var(--ed-gold, #76572c); align-self: start; }
  .tag { font: .75rem var(--ed-mono, monospace); letter-spacing: .1em; color: var(--ed-accent, #5b4055); margin: 0; display: block; }
  h3 { font: 400 1.5rem/1.2 var(--ed-serif, Georgia, serif); margin: .4rem 0; } .d { font-size: .9rem; line-height: 1.7; color: var(--ed-ink-2, #6a6067); margin: 0; }
  .cover { width: 150px; height: 196px; background: var(--ed-accent, #5b4055); color: #f4e9d5; box-shadow: 8px 8px 0 #d1c8be; padding: .7rem; display: flex; justify-content: flex-end; }
  .cover b { writing-mode: vertical-rl; letter-spacing: .1em; font-size: 1.15rem; line-height: 1.1; }
  .drawer { margin: .8rem 0 0 3.8rem; padding: .9rem 0 .2rem; border-top: 1px dashed var(--ed-line, #b8b0ab); } .drawer p { font-size: .9rem; line-height: 1.7; margin: 0; }
  .row { display: grid; grid-template-columns: 1fr 1fr; } .row article { padding: 1.3rem 1rem 1rem 0; border-right: 1px solid var(--ed-line, #c2b9b2); } .row article + article { padding-left: 1.3rem; border-right: 0; }
  @media (max-width: 800px) { .s06 { grid-template-columns: 200px 1fr; gap: 2rem; } summary { grid-template-columns: 2rem 1fr 100px; } .cover { width: 100px; height: 150px; } }
  @media (max-width: 600px) {
    .s06 { grid-template-columns: 1fr; gap: 1rem; } ol { display: flex; flex-wrap: wrap; gap: 0 1rem; } li { border-top: 0; }
    .note { max-width: none; margin: 1rem 0; } summary { grid-template-columns: 1.6rem 1fr 72px; gap: .6rem; } .cover { width: 72px; height: 112px; padding: .4rem; box-shadow: 5px 5px 0 #d1c8be; } .cover b { font-size: .9rem; }
    .drawer { margin-left: 2.2rem; } .row { grid-template-columns: 1fr; } .row article, .row article + article { padding: 1rem 0; border-right: 0; border-bottom: 1px solid var(--ed-line, #c2b9b2); }
  }
</style>