---
/**
 * R06 media-accent — 媒體（圖／SVG／CSS 繪製物）的「識別處理」：傾斜 ≤ 3deg、硬陰影、拱形、白框，四選一。
 * 規則 [NEW]：傾斜只加在媒體，不加在文字容器；一頁只用一種處理；hard 陰影偏移 ≤ 12px。
 * 十款 [OBS]：arch（fn、co、cg）、mat+tilt（cu）、hard-shadow（ll、ma）、tilt only（es、ra）。
 */
interface Props { treatment?: 'arch' | 'mat' | 'hard' | 'plain'; tilt?: number; ratio?: string; src?: string; alt?: string; caption?: string }
const { treatment = 'plain', tilt = 0, ratio = '4 / 3', src, alt = '', caption } = Astro.props;
const t = Math.max(-3, Math.min(3, tilt));
---
<figure class={`r06 ${treatment}`} style={`--tilt:${t}deg;--ratio:${ratio}`}>
  <div class="frame">
    {src ? <img src={src} alt={alt} loading="lazy" /> : <div class="art" role="img" aria-label={alt || '示意圖'}></div>}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
<style>
  .r06 { margin: 0; transform: rotate(var(--tilt)); }
  .frame img, .art { display: block; width: 100%; aspect-ratio: var(--ratio); object-fit: cover; }
  .art { background: linear-gradient(135deg, var(--ed-panel, #ebe4d4), color-mix(in srgb, var(--ed-accent-deco, #c8613f) 35%, var(--ed-panel, #ebe4d4))); }
  .arch .frame { border-radius: 48% 48% 4px 4px; overflow: hidden; }
  .mat .frame { background: #fff; padding: .7rem .7rem 2.2rem; box-shadow: 0 18px 50px #0000001a; }
  .hard .frame { border: 2px solid var(--ed-ink, #222018); box-shadow: 10px 10px 0 var(--ed-accent-deco, #c8613f); }
  figcaption { font: .75rem var(--ed-mono, monospace); color: var(--ed-ink-2, #57534a); margin-top: .6rem; }
</style>