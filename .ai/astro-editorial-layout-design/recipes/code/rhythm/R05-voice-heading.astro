---
/**
 * R05 voice-heading — 「雙聲」標題：主聲（粗/正體）+ 副聲（襯線斜體/換色），以短語（inline-block）換行，
 * 取代十款的手動 <br/>：短語不可被拆開、整體 text-wrap: balance，窄螢幕不會出現單字孤行。
 * 十款 [OBS]：fn/es/cu/co/so（Georgia 斜體換色）、ra/ll/ma/cg（無襯線 + Georgia 斜體）。
 * level：1–3，對應 clamp 字級；CJK：line-height ≥ 1.04、letter-spacing −.03em。
 */
interface Props { phrases: string[]; voice?: string; level?: 1 | 2 | 3; serif?: boolean }
const { phrases, voice, level = 2, serif = false } = Astro.props;
const Tag = (`h${level}`) as 'h1' | 'h2' | 'h3';
---
<Tag class:list={['r05', `lv${level}`, { serif }]}>{phrases.map((p) => <span class="ph">{p}</span>)}{voice && <em class="ph">{voice}</em>}</Tag>
<style>
  .r05 { margin: 0; letter-spacing: -.03em; text-wrap: balance; font-family: var(--ed-sans, sans-serif); font-weight: 800; color: inherit; }
  .r05.serif { font-family: var(--ed-serif, Georgia, serif); font-weight: 400; }
  .lv1 { font-size: clamp(3rem, 9vw, 8.5rem); line-height: 1.04; }
  .lv2 { font-size: clamp(2.2rem, 5vw, 4.6rem); line-height: 1.1; }
  .lv3 { font-size: clamp(1.4rem, 2.4vw, 2rem); line-height: 1.3; letter-spacing: -.01em; }
  .ph { display: inline-block; margin-right: .25em; }   /* 用 margin-right：詞組換行後行首不會有多餘縮排 */
  em { font-family: var(--ed-serif, Georgia, serif); font-style: italic; font-weight: 400; color: var(--ed-accent, #9a3b24); }
</style>