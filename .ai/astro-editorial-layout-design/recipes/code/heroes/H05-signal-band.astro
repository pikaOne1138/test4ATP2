---
/**
 * H05 signal-band — 深色頁 hero：文案 + 封面 + 跨整列的資料條（衍生自 05 聲音通信的波形帶）
 * 動畫只在 [data-live="true"] 時啟動；預設靜止，天然符合 reduced-motion。
 * 資料條由 frontmatter 偽隨機公式產生（確定性，非 Math.random）。
 */
interface Props { kicker?: string; first?: string; voice?: string; body?: string; link?: string; href?: string; bars?: number; src?: string; alt?: string; capL?: string; capR?: string }
const {
  kicker = 'A SMALL SIGNAL IN THE NIGHT', first = '按下播放，', voice = '這封信說給你聽。',
  body = '一個關於想法、生活與那些還在形成中的答案的聲音節目。',
  link = '打開本期逐字稿', href = '#notes', bars = 72,
  src, alt = '', capL = 'ON AIR / 018', capR = '~00:25',
} = Astro.props;
---
<section class="h05" data-live="false">
  <div class="copy">
    <p class="label">{kicker}</p>
    <h1><span class="ph">{first}</span> <em class="ph">{voice}</em></h1>
    <p class="body">{body}</p>
    <a href={href}>{link} <span aria-hidden="true">↘</span></a>
  </div>
  <figure>
    {src ? <img src={src} alt={alt} width="1200" height="900" /> : <div class="art" role="img" aria-label={alt || '示意圖'}></div>}
    <figcaption><span>{capL}</span><span>{capR}</span></figcaption>
  </figure>
  <div class="wave" aria-hidden="true">{Array.from({ length: bars }, (_, i) => <i style={`--bar:${((i * 17) % 7) + 2};--lag:${i * 13}ms`}></i>)}</div>
</section>
<style>
  .h05 { background: var(--ed-dark, #111a24); color: var(--ed-on-dark, #eceee9); padding: clamp(2.5rem, 6vw, 4rem) max(var(--ed-gutter, 4vw), calc((100% - var(--ed-wide, 1320px)) / 2 + var(--ed-gutter, 4vw))) 3rem; }
  .h05 { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); column-gap: 5vw; align-items: center; }
  .copy, figure, .wave { margin-inline: 0; }
  .label { font: .75rem var(--ed-mono, monospace); letter-spacing: .14em; color: #6fe0d2; margin: 0; }
  h1 { font: 700 clamp(3rem, 7vw, 6.5rem)/1.06 var(--ed-sans, sans-serif); letter-spacing: -.03em; margin: 1rem 0; text-wrap: balance; }
  .ph { display: inline-block; }
  h1 em { font: 400 italic 1em var(--ed-serif, Georgia, serif); color: #6fe0d2; }
  .body { max-width: 28em; color: var(--ed-on-dark-2, #bbc2c7); line-height: 1.8; }
  .copy a { display: inline-flex; align-items: center; min-height: 44px; margin-top: 1rem; border-bottom: 1px solid #6fe0d2; color: inherit; text-decoration: none; font: .8rem var(--ed-mono, monospace); }
  .copy a span { margin-left: .8rem; color: #6fe0d2; }
  figure { margin: 0; transform: rotate(1deg); }
  figure img, .art { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border: 1px solid #374955; }
  .art { background: radial-gradient(ellipse at 50% 120%, #6fe0d233, #0000 60%), linear-gradient(180deg, #1c2a38, #0d141c); }
  figcaption { display: flex; justify-content: space-between; color: var(--ed-on-dark-2, #9ea9b5); font: .75rem var(--ed-mono, monospace); padding: .6rem 0; border-bottom: 1px solid #34404c; }
  .wave { grid-column: 1 / -1; height: 70px; display: flex; align-items: center; gap: 4px; overflow: hidden; margin-top: 2.5rem; border-block: 1px solid #34404c; padding: 0 1rem; }
  .wave i { display: block; flex: 1; max-width: 13px; height: calc(var(--bar) * 7px); background: linear-gradient(0deg, #344e5c, #6fe0d2); opacity: .62; border-radius: 5px; }
  .h05[data-live="true"] .wave i { animation: pulse 1.8s ease-in-out infinite alternate; animation-delay: var(--lag); }
  @keyframes pulse { to { transform: scaleY(.45); opacity: .35; } }
  @media (prefers-reduced-motion: reduce) { .h05[data-live="true"] .wave i { animation: none; } }
  @media (max-width: 760px) { .h05 { grid-template-columns: 1fr; gap: 2rem; } figure { width: 86%; margin-left: auto; } .wave { margin-top: 1rem; } .wave i:nth-child(n+25) { display: none; } }
</style>