---
import config from '../../site.config.json';
import StudentNavigation from '../components/StudentNavigation.astro';
import SelectedPatterns from '../components/SelectedPatterns.astro';
const {title,description=config.brand.tagline,chrome=true}=Astro.props;
const base=import.meta.env.BASE_URL;
---
<!doctype html><html lang="zh-Hant"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}｜{config.brand.name}</title><meta name="robots" content="noindex,nofollow,noarchive"/><meta name="description" content={description}/><link rel="canonical" href={new URL(Astro.url.pathname,Astro.site??Astro.url).href}/><link rel="stylesheet" href={base+(chrome?'site.css':'home.css')}/><link rel="stylesheet" href={base+'blocks.css'}/><link rel="stylesheet" href={base+'effects.css'}/></head>
<body><a href="#main" class="skip">跳到主要內容</a>{chrome && <header><a class="brand" href={base}>{config.brand.name}</a><StudentNavigation /><a class="button" href={base+config.primaryCta.pageId+'/'}>{config.primaryCta.label}</a></header>}<main id="main" tabindex="-1"><slot/></main>{config.sectionPatterns?.some(x=>x.patternId.startsWith('footer-'))?<SelectedPatterns page="site-wide" />:<footer>© {new Date().getFullYear()} {config.brand.name}</footer>}</body></html>